{
    "name": "lustmored/oauth2-lockme",
    "description": "LockMe OAuth2 provider",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "league/oauth2-client": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Lockme\\OAuth2\\Client\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Jakub Caban",
            "email": "kontakt@lockme.pl"
        }
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.70",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "check": [
            "@cs",
            "@stan"
        ]
    }
}
